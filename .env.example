PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sawtdeen

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# UPI / Payment
UPI_MERCHANT_ID=
UPI_MERCHANT_KEY=

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Backblaze B2 (cloud file storage)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=

# Notification (Firebase Cloud Messaging)
# FCM_SERVER_KEY is obsolete — Google shut down the legacy FCM API in June 2024.
# Push now uses the HTTP v1 API, which needs a service account from
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Set ONE of the following. Leave both empty to disable push (the API still boots
# and in-app notifications keep working).
#   Local dev: path to the downloaded JSON (keep it out of git)
FIREBASE_SERVICE_ACCOUNT_PATH=
#   Vercel/CI: the same JSON pasted as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMS (Fast2SMS)
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_TEMPLATE_ID=
BYPASS_SMS=true
